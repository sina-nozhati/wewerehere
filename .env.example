# Copy to .env locally, or /etc/wewerehere/sms.env on the VPS (chmod 600).
# Never commit real API keys.

ADMIN_PASSWORD=
CAPACITY=50

# SMS — console (dev sink) | smsir (production)
SMS_PROVIDER=console
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID_TICKET_NOTIFY=0
SMS_IR_TEMPLATE_ID_ADMIN=0
SMS_IR_VERIFY_PARAMETER_NAME=CODE
SMS_IR_TIMEOUT=10
# Optional JSON presets for admin panel (overrides default ticket/notice templates):
# SMS_IR_ADMIN_PRESETS=[{"id":"ticket","label":"صدور بلیت","templateId":111,"param":"CODE"},{"id":"notice","label":"اطلاع‌رسانی","templateId":222,"param":"CODE"}]

# ==============================================================================
# Media Storage Manager Configuration
# ==============================================================================

# Files.ir Official Storage Integration
# Primary cloud storage provider for event photos and memories.
FILES_IR_API_ENDPOINT=https://my.files.ir/api/v1
FILES_IR_API_KEY=
FILES_IR_WORKSPACE_ID=0
FILES_IR_TOTAL_CAPACITY_BYTES=10737418240
FILES_IR_FILE_COUNT_LIMIT=3000
FILES_IR_MAX_FILE_SIZE_BYTES=524288000

# S3-Compatible Object Storage (e.g., ArvanCloud, Liara, MinIO, Cloudflare R2, AWS S3)
# Secondary fallback or event-assigned cloud storage provider.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Storage Quota and Routing Monitors
STORAGE_WARNING_THRESHOLD=0.80
STORAGE_CRITICAL_THRESHOLD=0.90
STORAGE_RESERVATION_TTL_SEC=1800
