{
  "name": "wewerehere",
  "version": "2.0.0",
  "private": true,
  "description": "WE WERE HERE — multi-event tickets + Python backend",
  "scripts": {
    "predev": "python -m pip install -r backend/requirements.txt",
    "dev": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 5173",
    "start": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 5173",
    "dev:node": "node --disable-warning=ExperimentalWarning server.js",
    "test": "cd backend && python -m pytest -q",
    "check:png": "python backend/scripts/check_ticket_png.py",
    "migrate": "python backend/scripts/migrate_legacy.py"
  }
}
